<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
             xmlns:md="clr-namespace:Markdown.Avalonia;assembly=Markdown.Avalonia"
             xmlns:vm="clr-namespace:Stonks.Client.Desktop.ViewModels"
             x:Class="Stonks.Client.Desktop.Views.SearchAnalyzeView"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- Error banner (visible only when HasError is true) -->
        <Border Grid.Row="0"
                Background="#F8D7DA"
                BorderBrush="#F5C6CB"
                BorderThickness="1"
                CornerRadius="4"
                Padding="10,8"
                Margin="8,8,8,0"
                IsVisible="{Binding HasError}">
            <TextBlock Text="{Binding ErrorMessage}"
                       Foreground="#721C24"
                       TextWrapping="Wrap" />
        </Border>

        <!-- Input row -->
        <Border Grid.Row="1" Padding="12">
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="Ticker:" />
                <TextBox Width="80" Text="{Binding Ticker}" />
                <TextBlock VerticalAlignment="Center" Text="From:" />
                <DatePicker SelectedDate="{Binding StartDate}" />
                <TextBlock VerticalAlignment="Center" Text="To:" />
                <DatePicker SelectedDate="{Binding EndDate}" />
                <Button Content="Analyze" Command="{Binding AnalyzeCommand}" />
                <Button Content="Copy" IsEnabled="{Binding HasAnalysisText}" Click="OnCopyClick" />
                <ToggleButton Content="💬 Follow-Up Q&amp;A"
                              IsChecked="{Binding IsQaPanelVisible}"
                              IsVisible="{Binding HasAnalysisText}" />
                <TextBlock VerticalAlignment="Center"
                           Text="Loading..."
                           IsVisible="{Binding IsLoading}" />
            </StackPanel>
        </Border>

        <!-- Content row: chart, analysis text, follow-up Q&A chat -->
        <Grid x:Name="ContentGrid" Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="0" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="4" RowDefinitions="Auto,*,Auto,Auto">

                <!-- Signal badge strip (empty/collapsed until an analysis has run) -->
                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding Indicators.SignalBadges}"
                              IsVisible="{Binding HasIndicators}"
                              Margin="0,0,0,4">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:BadgeViewModel}">
                            <Border Background="{Binding Color}"
                                    CornerRadius="4"
                                    Padding="5,2"
                                    Margin="2,1">
                                <TextBlock Text="{Binding Name}" FontSize="11" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <sp:AvaPlot x:Name="AvaPlot" Grid.Row="1" />

                <GridSplitter Grid.Row="2" Height="5"
                              HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                              Background="#DDD" ResizeDirection="Rows"
                              IsVisible="{Binding HasIndicators}" />

                <!-- Technicals panel -->
                <Grid Grid.Row="3" RowDefinitions="Auto,Auto" IsVisible="{Binding HasIndicators}">
                    <Button Grid.Row="0"
                            Command="{Binding ToggleTechnicalsPanelCommand}"
                            Background="Transparent" BorderThickness="0"
                            Padding="0" HorizontalAlignment="Left"
                            HorizontalContentAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="▾" IsVisible="{Binding IsTechnicalsPanelExpanded}" />
                            <TextBlock Text="▸" IsVisible="{Binding !IsTechnicalsPanelExpanded}" />
                            <TextBlock Text="Technicals" FontWeight="Bold" />
                        </StackPanel>
                    </Button>

                    <Grid Grid.Row="1" ColumnDefinitions="*,*"
                          IsVisible="{Binding IsTechnicalsPanelExpanded}"
                          Margin="0,4,0,0">

                        <StackPanel Grid.Column="0" Spacing="2" Margin="0,0,8,0">
                            <TextBlock Text="Moving Averages" FontWeight="Bold" FontSize="12" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding Indicators.MovingAverageRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IndicatorRowViewModel}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" />
                                            <TextBlock Text="{Binding Label}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="Support / Resistance" FontWeight="Bold" FontSize="12" Margin="0,8,0,2" />
                            <DockPanel>
                                <TextBlock Text="{Binding Indicators.SupportText}" DockPanel.Dock="Right" />
                                <TextBlock Text="Support" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding Indicators.ResistanceText}" DockPanel.Dock="Right" />
                                <TextBlock Text="Resistance" />
                            </DockPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="Momentum &amp; Oscillators" FontWeight="Bold" FontSize="12" Margin="0,0,0,2" />
                            <ItemsControl ItemsSource="{Binding Indicators.MomentumRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IndicatorRowViewModel}">
                                        <DockPanel>
                                            <TextBlock Text="{Binding Value}" DockPanel.Dock="Right" />
                                            <TextBlock Text="{Binding Label}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDD" ResizeDirection="Columns" />

            <md:MarkdownScrollViewer Grid.Column="2" Margin="4"
                                     Markdown="{Binding AnalysisText}" />

            <GridSplitter Grid.Column="3" Width="5"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="#DDD" ResizeDirection="Columns"
                          IsVisible="{Binding IsQaPanelVisible}" />

            <Border Grid.Column="4" Margin="4"
                    BorderBrush="#DDD" BorderThickness="1,0,0,0" Padding="8,0,0,0"
                    IsVisible="{Binding IsQaPanelVisible}">
                <Grid RowDefinitions="Auto,*,Auto">

                    <TextBlock Grid.Row="0" Text="Follow-Up Questions" FontWeight="Bold" Margin="0,0,0,8" />

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding FollowUpTurns}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:QaTurnViewModel}">
                                    <StackPanel Margin="0,0,0,12">
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="Copy"
                                                    Padding="6,2" FontSize="11"
                                                    Click="OnCopyQaTurnClick" />
                                            <TextBlock Text="{Binding Question}" FontWeight="Bold" TextWrapping="Wrap" />
                                        </DockPanel>
                                        <md:MarkdownScrollViewer Markdown="{Binding Answer}"
                                                                  Margin="0,4,0,0" />
                                        <TextBlock Text="Thinking..." FontStyle="Italic" Foreground="Gray"
                                                   IsVisible="{Binding IsAnswering}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                        <TextBox Width="160" Text="{Binding FollowUpQuestion}" Watermark="Ask a follow-up...">
                            <TextBox.KeyBindings>
                                <KeyBinding Gesture="Enter" Command="{Binding AskFollowUpCommand}" />
                            </TextBox.KeyBindings>
                        </TextBox>
                        <Button Content="Ask" Command="{Binding AskFollowUpCommand}" />
                    </StackPanel>

                </Grid>
            </Border>
        </Grid>

    </Grid>

</UserControl>
